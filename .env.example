# ============================================================================
# LLM: set ONE key. The first one found is used (or force with LLM_PROVIDER).
# ============================================================================

# Free: Google Gemini API key from https://aistudio.google.com/apikey (no card needed)
GEMINI_API_KEY=

# Free: Groq key from https://console.groq.com/keys (small per-minute token limit on the free plan)
GROQ_API_KEY=

# Paid, best quality: Anthropic key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Any other OpenAI-compatible endpoint (OpenRouter, OpenAI, local Ollama / LM Studio)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# e.g. http://localhost:11434/v1 for Ollama (no key needed; set MODEL too)
OPENAI_BASE_URL=

# anthropic | gemini | groq | openrouter | openai   (optional; auto-detected from the key)
LLM_PROVIDER=
# Override the default model for the provider.
# Defaults: gemini → gemini-3.5-flash-lite, groq → openai/gpt-oss-120b, anthropic → claude-sonnet-5-5
MODEL=
FAST_MODEL=

# ============================================================================
# Web search: set ONE (Tavily preferred, Brave as fallback). Both have free plans.
# ============================================================================
# https://app.tavily.com
TAVILY_API_KEY=
# https://brave.com/search/api/
BRAVE_API_KEY=

# ============================================================================
# Optional
# ============================================================================
# Anthropic only: low | medium | high
EFFORT=medium
# OpenAI-compatible reasoning models only: low | medium | high (unset = provider default)
REASONING_EFFORT=
# Set to "off" to skip the background memory-extraction call (saves free-tier quota)
DISTILL=on
PORT=3000
# Fallback timezone if the browser doesn't send one
DEFAULT_TZ=UTC
# Freeze the agent's clock for testing, e.g. 2026-11-10T09:00:00Z
AGENT_NOW=
DATA_FILE=data/store.json
